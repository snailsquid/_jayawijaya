{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "chrome-devtools": {
      "enabled": true,
      "type": "local",
      "command": ["npx", "-y", "chrome-devtools-mcp@latest"]
    }
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "maxContext": 100000,
    "threshold": 0.5
  }
}
