{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "jayawijaya",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-09-08",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true,
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "jayawijaya",
      "database_id": "78e55c85-d849-42d6-a57f-bf00e2cb2937",
      "migrations_dir": "migrations",
    },
  ],
  "vars": {
    "BETTER_AUTH_URL": "https://jayawijaya.arkk.workers.dev",
    "OAUTH_PROXY_TRUSTED_ORIGINS": "https://acromion.org,https://*.acromion.org,https://*-jayawijaya.arkk.workers.dev",
    "ENVIRONMENT": "development",
    "MIDTRANS_IS_PRODUCTION": "false",
  },
}
