{
  "name": "temp-project",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "db:migrate:local": "wrangler d1 migrations apply jayawijaya --local",
    "db:migrate:test": "wrangler d1 migrations apply jayawijaya-test --local --config wrangler.test.jsonc",
    "dev:test": "vite --mode test --host 127.0.0.1",
    "build:test": "tsc -b && vite build --mode test",
    "serve:test": "wrangler dev --config wrangler.test.jsonc --ip 127.0.0.1 --port 5173",
    "test": "bun run test:unit && bun run test:integration",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.worker.config.ts",
    "test:e2e": "playwright test",
    "check:ui": "! rg 'neu-|style=\\{\\{' src/pages src/components --glob '!src/components/ui/**'",
    "test:coverage": "vitest run --config vitest.config.ts --coverage",
    "preview": "vite preview"
  },
  "dependencies": {
    "@cloudflare/vite-plugin": "^1.54.5",
    "better-auth": "1.6.23",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "idb": "^8.0.3",
    "js-yaml": "^4.1.1",
    "lucide-react": "^1.42.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.14.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260908.1",
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.2.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "4.1.11",
    "autoprefixer": "^10.4.27",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.4.0",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.8",
    "tailwindcss": "^4.2.2",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.4",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "4.1.11",
    "wrangler": "^4.129.1"
  }
}
